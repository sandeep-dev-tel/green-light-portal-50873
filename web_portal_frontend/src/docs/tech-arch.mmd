---
config:
  maxTextSize: 1000000
---
graph TD
  %% Tier 1: Intake
  subgraph Tier1["Layer 1: Automated Triage"]
    A["User Input: Logs, Video, Code"] --> B["Gateway & AuthZ"]
    B --> C["L1 Triage Agent"]
    C --> D{"Resolved at L1?"}
  end

  %% Jira as System of Record
  subgraph JiraSystem["Jira Ticketing System"]
    direction TB
    JS["Jira API Gateway"]
    S1["Status: Triage (L1)"]
    S2["Status: Investigating (L2)"]
    S3["Status: Expert Review (L3)"]
    S4["Status: Resolved / Closed"]
    
    JS --> S1
  end

  %% Shared Services (The Memory Layer)
  subgraph SharedServices["Shared Data & Memory Layer"]
    MEM["Short-Term Task Context"]
    RAG_DB[("Vector DB: Enterprise Knowledge")]
    Jira_Hist[("Jira History & Git Logs")]
  end

  %% Tier 2 Swarm
  subgraph Tier2["Layer 2: Specialized Swarm"]
    direction LR
    G1["Log Detective"]
    G2["Visual Analysis"]
    G3["Code Surgeon"]
    
    G1 & G2 & G3 --> Agg["Result Aggregator"]
  end

  %% ESCALATIONS & STATUS UPDATES
  D -- "Yes" --> J_Close1["API: Resolve Ticket"] --> S4
  D -- "No" --> J_Esc1["API: Update Status to L2"] --> S2
  
  S2 --> Planner["Task Planner & Router"]
  Planner --> DAG["DAG Engine"]
  
  DAG -- "Parallel Fan-out" --> G1
  DAG -- "Parallel Fan-out" --> G2
  DAG -- "Parallel Fan-out" --> G3
  
  %% Memory access
  G1 & G2 & G3 -.-> MEM
  G1 & G2 & G3 -.-> RAG_DB
  
  %% L2 to L3 Transition
  Agg --> L2D{"Root Cause?"}
  L2D -- "Yes" --> J_Close2["API: Resolve Ticket"]
  L2D -- "No" --> J_Esc2["API: Update Status to L3"] --> S3
  
  S3 --> L3["L3 Expert RCA Agent"]
  L3 --> Policy["Policy Engine & HITL Gate"]
  Policy -- "Approved" --> J_Close3["API: Resolve Ticket"]

  %% FEEDBACK HUB
  S4 --> Resp["Responder Agent"]
  Resp --> Rep["Final Report & Fix"]
  Rep --> FB["User Feedback: 👍/👎"]
  FB -- "Helpful" --> KB["KB Update & Sync"]
  KB -.-> RAG_DB
  KB -.-> Jira_Hist

  %% Styling
  style JiraSystem fill:#e0e7ff,stroke:#3730a3
  style SharedServices fill:#f5f5f5,stroke:#737373
  style S4 fill:#4ade80,font-weight:bold
  style Policy fill:#fca5a5,stroke:#b91c1c